<Window x:Class="ConfigureLensHHStockMcp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LensHH Stock-MCP Configure"
        Icon="icon.ico"
        Width="680" Height="560"
        MinWidth="520" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="StatusIndicator" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,2,0,4"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Intro blurb -->
        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,4">
            Registers the standalone LensHH Stock-MCP server with Claude Desktop and Claude Code.
            The Stock-MCP exposes the bundled stock-lens catalog (search, lens details, .lhlt export) and is engine-free —
            it doesn't load the LensHH-LT optical-design runtime.
        </TextBlock>

        <!-- Server Executable Path -->
        <TextBlock Grid.Row="1" Text="LensHH Stock-MCP Server Path:" Style="{StaticResource SectionHeader}" Margin="0,8,0,4"/>

        <Grid Grid.Row="2" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="txtServerPath" Grid.Column="0" VerticalContentAlignment="Center"
                     IsReadOnly="True" Padding="4,3"/>
            <Button Grid.Column="1" Content="Browse..." Padding="12,3" Margin="8,0,0,0"
                    Click="BrowseServer_Click"/>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="txtServerStatus" Style="{StaticResource StatusIndicator}"/>

        <!-- Catalogs Directory -->
        <TextBlock Grid.Row="4" Text="Catalogs Directory (stock-lens database):" Style="{StaticResource SectionHeader}"/>

        <Grid Grid.Row="5" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="txtCatalogsPath" Grid.Column="0" VerticalContentAlignment="Center"
                     IsReadOnly="True" Padding="4,3"/>
            <Button Grid.Column="1" Content="Browse..." Padding="12,3" Margin="8,0,0,0"
                    Click="BrowseCatalogs_Click"/>
        </Grid>

        <TextBlock Grid.Row="6" x:Name="txtCatalogsStatus" Style="{StaticResource StatusIndicator}"/>

        <!-- Claude Desktop Section -->
        <TextBlock Grid.Row="7" Text="Claude Desktop:" Style="{StaticResource SectionHeader}"/>

        <TextBlock Grid.Row="8" x:Name="txtDesktopStatus" Style="{StaticResource StatusIndicator}"/>

        <StackPanel Grid.Row="9" Orientation="Horizontal" Margin="0,0,0,4">
            <Button Content="Configure Claude Desktop" Style="{StaticResource ActionButton}"
                    Click="ConfigureClaudeDesktop_Click"/>
            <Button Content="Remove from Claude Desktop" Style="{StaticResource ActionButton}"
                    Click="RemoveClaudeDesktop_Click"/>
        </StackPanel>

        <!-- Claude Code Section -->
        <TextBlock Grid.Row="10" Text="Claude Code:" Style="{StaticResource SectionHeader}"/>

        <StackPanel Grid.Row="11" Orientation="Vertical" VerticalAlignment="Top">
            <TextBlock x:Name="txtCodeStatus" Style="{StaticResource StatusIndicator}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Button Content="Configure Claude Code" Style="{StaticResource ActionButton}"
                        Click="ConfigureClaudeCode_Click"/>
                <Button Content="Remove from Claude Code" Style="{StaticResource ActionButton}"
                        Click="RemoveClaudeCode_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Status Bar -->
        <TextBlock Grid.Row="12" x:Name="txtStatus" Text="Ready" Foreground="Gray" Margin="0,8,0,0"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>
